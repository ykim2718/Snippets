this example simple</SPAN>=0A=
=0A=
  <SPAN class=3D"k">implicit none</SPAN>=0A=
=0A=
<SPAN class=3D"k">  </SPAN><SPAN class=3D"kt">real</SPAN><SPAN =
class=3D"p">,</SPAN> <SPAN class=3D"k">dimension</SPAN><SPAN =
class=3D"p">(:),</SPAN> <SPAN class=3D"k">allocatable</SPAN> <SPAN =
class=3D"kd">::</SPAN> <SPAN class=3D"n">points</SPAN>=0A=
  <SPAN class=3D"kt">integer</SPAN>                         <SPAN =
class=3D"kd">::</SPAN> <SPAN class=3D"n">number_of_points</SPAN>=0A=
  <SPAN class=3D"kt">real</SPAN>                            <SPAN =
class=3D"kd">::</SPAN> <SPAN class=3D"n">average_points</SPAN><SPAN =
class=3D"o">=3D</SPAN><SPAN class=3D"mf">0.</SPAN><SPAN =
class=3D"p">,</SPAN> <SPAN class=3D"n">positive_average</SPAN><SPAN =
class=3D"o">=3D</SPAN><SPAN class=3D"mf">0.</SPAN><SPAN =
class=3D"p">,</SPAN> <SPAN class=3D"n">negative_average</SPAN><SPAN =
class=3D"o">=3D</SPAN><SPAN class=3D"mf">0.</SPAN>=0A=
