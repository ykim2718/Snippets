width=3D"220" height=3D"106" class=3D"thumbimage" alt=3D"" =
src=3D"https://upload.wikimedia.org/wikipedia/commons/thumb/5/58/FortranC=
ardPROJ039.agr.jpg/220px-FortranCardPROJ039.agr.jpg"=20
data-file-height=3D"809" data-file-width=3D"1687" =
srcset=3D"//upload.wikimedia.org/wikipedia/commons/thumb/5/58/FortranCard=
