class=3D"p">(</SPAN><SPAN class=3D"mi">1</SPAN><SPAN =
class=3D"p">:</SPAN><SPAN class=3D"n">n2</SPAN><SPAN class=3D"p">)</SPAN>=0A=
          <SPAN class=3D"n">s</SPAN><SPAN class=3D"p">%</SPAN><SPAN =
class=3D"n">string_data</SPAN> <SPAN class=3D"o">=3D</SPAN> <SPAN =
class=3D"n">ctot</SPAN><SPAN class=3D"p">(</SPAN><SPAN =
class=3D"mi">1</SPAN><SPAN class=3D"p">:</SPAN><SPAN =
class=3D"mi">80</SPAN><SPAN class=3D"p">)</SPAN>=0A=
       <SPAN class=3D"k">END IF</SPAN>=0A=
<SPAN class=3D"k">       </SPAN><SPAN class=3D"n">s</SPAN><SPAN =
class=3D"p">%</SPAN><SPAN class=3D"n">length</SPAN> <SPAN =
class=3D"o">=3D</SPAN> <SPAN class=3D"nb">LEN_TRIM</SPAN><SPAN =
class=3D"p">(</SPAN><SPAN class=3D"n">s</SPAN><SPAN =
class=3D"p">%</SPAN><SPAN class=3D"n">string_data</SPAN><SPAN =
class=3D"p">)</SPAN>=0A=
       <SPAN class=3D"n">string_concat</SPAN> <SPAN =
class=3D"o">=3D</SPAN> <SPAN class=3D"n">s</SPAN>=0A=
    <SPAN class=3D"k">END FUNCTION </SPAN><SPAN =
class=3D"n">string_concat</SPAN>=0A=
 <SPAN class=3D"k">END MODULE </SPAN><SPAN class=3D"n">string_type</SPAN>=0A=
 =0A=
 <SPAN class=3D"k">PROGRAM </SPAN><SPAN class=3D"n">main</SPAN>=0A=
 <SPAN class=3D"k">USE </SPAN><SPAN class=3D"n">string_type</SPAN>=0A=
 <SPAN class=3D"k">TYPE</SPAN><SPAN class=3D"p">(</SPAN><SPAN =
class=3D"n">string80</SPAN><SPAN class=3D"p">)</SPAN> <SPAN =
class=3D"kd">::</SPAN> <SPAN class=3D"n">s1</SPAN><SPAN =
class=3D"p">,</SPAN> <SPAN class=3D"n">s2</SPAN><SPAN =
class=3D"p">,</SPAN> <SPAN class=3D"n">s3</SPAN>=0A=
 <SPAN class=3D"k">CALL </SPAN><SPAN =
class=3D"n">c_to_s_assign</SPAN><SPAN class=3D"p">(</SPAN><SPAN =
class=3D"n">s1</SPAN><SPAN class=3D"p">,</SPAN><SPAN class=3D"s1">'My =
name is'</SPAN><SPAN class=3D"p">)</SPAN>=0A=
 <SPAN class=3D"k">CALL </SPAN><SPAN =
class=3D"n">c_to_s_assign</SPAN><SPAN class=3D"p">(</SPAN><SPAN =
class=3D"n">s2</SPAN><SPAN class=3D"p">,</SPAN><SPAN class=3D"s1">' =
Linus Torvalds'</SPAN><SPAN class=3D"p">)</SPAN>=0A=
 <SPAN class=3D"n">s3</SPAN> <SPAN class=3D"o">=3D</SPAN> <SPAN =
class=3D"n">s1</SPAN><SPAN class=3D"o">//</SPAN><SPAN =
class=3D"n">s2</SPAN>=0A=
 <SPAN class=3D"k">WRITE</SPAN><SPAN class=3D"p">(</SPAN><SPAN =
class=3D"o">*</SPAN><SPAN class=3D"p">,</SPAN><SPAN =
class=3D"o">*</SPAN><SPAN class=3D"p">)</SPAN> <SPAN =
class=3D"s1">'Result: '</SPAN><SPAN class=3D"p">,</SPAN><SPAN =
class=3D"n">s3</SPAN><SPAN class=3D"p">%</SPAN><SPAN =
class=3D"n">string_data</SPAN>=0A=
 <SPAN class=3D"k">WRITE</SPAN><SPAN class=3D"p">(</SPAN><SPAN =
class=3D"o">*</SPAN><SPAN class=3D"p">,</SPAN><SPAN =
class=3D"o">*</SPAN><SPAN class=3D"p">)</SPAN> <SPAN =
