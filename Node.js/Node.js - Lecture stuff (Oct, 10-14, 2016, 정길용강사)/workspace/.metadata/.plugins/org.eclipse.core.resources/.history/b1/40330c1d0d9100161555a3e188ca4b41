function chat(io) {
	console.log('Socket.io server start.');
	io.on('connection', function(s){
		console.log('클라이언트 접속', s.client.conn.remoteAddress);
    s.on('login', function(nickname){
    	s.nickname = nickname;
    	//console.log('시스템: ' + nickname + ' 님이 입장하였습니다');
    	io.emit('시스템: ' + nickname + ' 님이 입장하였습니다'); // io는 전체에 공지
    });
    s.on('chat', function(msg){
    	//console.log(msg);
    	io.emit(msg);
    });
    s.on('disconnect', function(){
    	//console.log('시스템: ' + s.nickname + ' 님이 퇴장했습니다');
    	io.emit('시스템: ' + s.nickname + ' 님이 퇴장했습니다');
    });
	});
}

module.exports = chat;