function whatsThis() {
  return this.toString();
}
var unikys = {
  what: whatsThis,
  toString: function () {
      return "[object unikys]";
  }
};
whatsThis();    // #1
unikys.what();    //  #2
whatsThis.call();    //  #3
whatsThis.apply(unikys);    // #4
unikys.what.call(undefined);    //  #5
unikys.what.apply(unikys);    //  #6