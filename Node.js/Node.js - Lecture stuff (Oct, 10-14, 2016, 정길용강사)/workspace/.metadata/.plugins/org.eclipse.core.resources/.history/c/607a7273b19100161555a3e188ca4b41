// 현재 DB 삭제
db.runCommand({dropDatabase: 1});

// 등록할 게시물
var b1 = {
		_id: 1,
		title: '첫번째 게시물',
		writer: '김철수',
		content: '첫번째 게시물 입니다.',
		view: 0,
		regdate: '04.08 12:34'
};
var b2 = {
		_id: 2,
		title: '두번째 게시물',
		writer: '이영희',
		content: '두번째 게시물 입니다.',
		view: 0,
		regdate: '04.09 12:54'
};

// 게시물 등록(collection.insert(document))
db.board.insert(b1);
db.board.insert(b2);

// 게시물 목록 조회
// collection.find({검색조건}, {출력속성})).sort({정렬옵션}).limit(개수)
db.board.find();
db.board.find({_id:2});
db.board.find({_id:1, writer:'김철수'}); // 검색조건만 있고 출력조건은 없을때
db.board.find({writer:'김철수'}, {writer:1, _id:0}); // writer 만 출력하려면 해당 속성 값을 1로 함
db.board.find({}, {writer:1, _id:0}); // 모든 게시물의 writer 만 출력하는 경우
db.board.find().sort({_id:1}); // 1 오름차순, -1 내림차순
db.board.find().sort({_id:-1}).limit(1); // 결과를 한개로 제한 할 때

// 모든 게시물을 _id의 내림 차순으로 조회 (출력 컬럼은 번호, 제목, 글쓴이, 조회수, 작성일
db.board.find({}, {content:0}).sort({_id:-1});

// 게시물 상세 조회
db.board.findOne({_id:2}, {writer:1, title:1, content:1});


// 게시물 수정(collection.update({검색조건}, {수정할문서}))
db.board.update({_id:1}, {title:'수정한 제목'}); // 통째로 변경됨
db.board.update({_id:1}, {$set:{title:'수정한 제목'}}); // 일부 변경
db.board.update({_id:1}, {$inc: {view: 1}});


// 게시물 상세 조회와 업데이트를 동시에 할 경우
var b3 = db.board.findOneAndUpdate({_id:2}, {$inc: {view: 1}}); // (조회 조건, 업데이트 조건)
b3;

// 게시물 삭제 {collection.remove({검색조건}))
db.board.remove();


