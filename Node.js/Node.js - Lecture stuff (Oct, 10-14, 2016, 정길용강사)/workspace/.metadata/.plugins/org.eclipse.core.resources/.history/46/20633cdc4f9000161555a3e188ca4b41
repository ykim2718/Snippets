var url = require('url')
var path = require('path')
var fs = require('fs')

var base = path.join('c:', 'node', 'workspace', 'nodeLab', 'ch06', 'public');
var logger = fs.createWriteStream(path.join(base, '../', 'log.txt'), {flags: 'a'});	

function mylogger(req, res, next) {
  var parseUrl = url.parse(req.url);
  var filepath = path.join(__dirname, parseUrl.pathname);

  var statusCode = 200;
  fs.stat(filepath, function(err, stats){
  	if (err) {
  		statusCode = 404;
  	} else if (stats.isFile()) {
  		statusCode = 200;
  	} else {
  		statusCode = 403;
  	}
    logger.write(Date()+ ' ' + statusCode + ' ' + parseUrl.pathname + '\n');
  });
}

module.exports = mylogger;