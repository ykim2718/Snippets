// load http core module
var http = require('http');
// load file system core module
var fs = require('fs');

// create http server
var server = http.createServer(function(req, res){
  // read helloNoe.js, Asynchronous way
	fs.readFile('helloNode.js', function(err, data){
		if (err) {
			console.error(err);
		} else {
			// 1 of 3 step, response header
			res.writeHead(200, {'Content-type': 'text/plain;charset=utf-8'});
			// 2 of 3 step, send response message
			res.write(data);
		}
	 	// 3 of 3 step, end response
		res.end();
	});
});

server.on('error', function(){});

//a || b -> a if a is true else b
// false criteria in JavaScript
// - boolean: false
// - number: 0
// - string: ''
// - object: null, undefined
var port = process.argv[2] || 8124;  

server.listen(port, function(){ // listen calls callback only at success
	console.log('Server running on http://localhost:' + port);
});
