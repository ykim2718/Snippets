var childProcess = require('child_process'); 
var child, file = process.argv[2];

// node hotdeploy.js net/tcpserver.js
function runChild(){
	if (file) {
		child = childProcess.spawn('node', [file]);
		console.log(file, '실행.');
		child.on('close', function(){
			console.log(file, '종료.');
		});
	} else {
		throw new Error('실행할 파일을 지정해주세요. node hotdploy 파일명');
	}
}

var fs = require('fs');
fs.watchFile(file, function(){
	child.kill();
  setTimeout(runChild, 1000);
});

runChild();



