<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Node.js 게시판</title>
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.2/css/bootstrap.min.css">
</head>
<body>
	<div class="container">
		<h1><%= title %></h1>
		<section>
			<form method="post" action="/board/new" class="form-horizontal">
				<div class="form-group">
					<label for="writer" class="col-sm-1 control-label">작성자</label>
					<div class="col-sm-3">
						<input type="text" class="form-control" id="writer" name="writer" required autofocus>
					</div>
				</div>
				<div class="form-group">
					<label for="title" class="col-sm-1 control-label">제목</label>
					<div class="col-sm-11">
						<input type="text" class="form-control" id="title" name="title" required placeholder="제목을 입력하세요.">
					</div>
				</div>
				<div class="form-group">
					<label for="content" class="sr-only">내용</label>
					<div class="col-sm-12">
						<textarea id="content" name="content" rows="15" class="form-control" required></textarea>
					</div>
				</div>
				<hr>
				<div class="form-group">
					<div class="text-center">
						<a href="/board/" class="btn btn-default">취소</a>
						<button type="submit" class="btn btn-primary">등록</button>
					</div>
				</div>
			</form>
		</section>
	</div>
</body>
</html>